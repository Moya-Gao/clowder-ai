# Cat Cafe 环境变量配置
# 复制此文件为 .env 并填入你的配置

# ======================
# API Keys (必填)
# ======================

# Anthropic API Key - 布偶猫 (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key - 缅因猫 (Codex)
OPENAI_API_KEY=sk-...

# Google API Key - 暹罗猫 (Gemini)
GOOGLE_API_KEY=...

# ======================
# 服务端口
# ======================

# MCP Server 端口
MCP_SERVER_PORT=3001

# API Backend 端口
API_SERVER_PORT=3002

# API Backend 监听地址（默认仅本机访问；如需局域网访问可设为 0.0.0.0）
API_SERVER_HOST=127.0.0.1

# Frontend 端口 (MCP Server 不再占 3001，前端直接用)
FRONTEND_PORT=3001

# ======================
# Hindsight（本仓库独立实例）
# ======================

# 本仓库默认使用 18888/19999，避免与其他项目冲突
HINDSIGHT_URL=http://localhost:18888
HINDSIGHT_SHARED_BANK=cat-cafe-shared
HINDSIGHT_ENABLED=true
HINDSIGHT_HEALTH_TIMEOUT_SECONDS=5
HINDSIGHT_STARTUP_TIMEOUT_SECONDS=300
HINDSIGHT_COMPOSE_PROJECT=cat-cafe-hindsight-local-instance
# Retain extraction quality (Pre-#69): world/experience evidence first
HINDSIGHT_API_RETAIN_EXTRACTION_MODE=custom
HINDSIGHT_API_RETAIN_CUSTOM_INSTRUCTIONS=ONLY extract evidence-backed facts with durable value for engineering decisions, constraints, or incident handling. DO NOT extract heading-only summaries, status slogans, one-line process chatter, or statements without concrete evidence. If a sentence is merely a title, section label, or generic meta statement, skip it. Prefer fewer high-signal facts over many low-signal facts.

# ======================
# Redis 配置
# ======================

# Redis 连接 URL
REDIS_URL=redis://localhost:6379

# ======================
# 数据存储
# ======================

# Cat Cafe 数据目录
CAT_CAFE_DATA_DIR=~/.cat-cafe

# 允许访问的工作目录 (逗号分隔)
ALLOWED_WORKSPACE_DIRS=/Users/lysander/projects

# ======================
# 模型配置 (可选覆盖)
# ======================

# 布偶猫模型 (默认: claude-sonnet-4-5-20250929)
# CAT_OPUS_MODEL=claude-opus-4-6

# 缅因猫模型 (默认: codex)
# CAT_CODEX_MODEL=gpt-5.3-codex

# 缅因猫 CLI 沙箱模式 (默认: danger-full-access，确保 callback 模式可写 .git 完成提交)
# 可选: read-only | workspace-write | danger-full-access
# CAT_CODEX_SANDBOX_MODE=danger-full-access

# 缅因猫 CLI 授权策略 (默认: on-request，支持动态授权交互)
# 可选: untrusted | on-failure | on-request | never
# CAT_CODEX_APPROVAL_POLICY=on-request

# 暹罗猫模型 (默认: gemini-2.5-pro)
# CAT_GEMINI_MODEL=gemini-3-pro

# A2A 猫猫互调最大深度 (默认: 2)
# MAX_A2A_DEPTH=2

# ======================
# 开发选项
# ======================

# 官方额度抓取浏览器（默认隔离，不会关闭当前 Chrome）
# 可选: isolated | existing
# isolated: 启动独立 profile 的 Chrome（推荐）
# existing: 复用现有本机 CDP（高级场景）
# QUOTA_BROWSER_MODE=isolated

# 隔离浏览器 CDP 端口（默认 9224）
# QUOTA_BROWSER_CDP_PORT=9224

# 隔离浏览器 profile 目录（默认 ~/.cat-cafe/quota-browser-profile）
# QUOTA_BROWSER_PROFILE_DIR=/Users/you/.cat-cafe/quota-browser-profile

# 是否启用无头模式（1=启用，0=关闭；默认 0）
# 首次使用建议保持 0，先完成网页登录。
# QUOTA_BROWSER_HEADLESS=0

# 是否允许自动启动隔离浏览器（默认 1）
# QUOTA_BROWSER_AUTO_START=1

# 是否允许自动重启浏览器（默认 0，危险操作）
# QUOTA_BROWSER_AUTO_RESTART=0

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 是否启用详细日志
DEBUG=false

# ======================
# Push 调试（可选）
# ======================

# 若 API 所在环境需要代理访问 FCM/Web Push，可配置 HTTP(S) 代理
# HTTPS_PROXY=http://127.0.0.1:7897

# Web Push 请求超时（毫秒，默认 10000）
# WEB_PUSH_TIMEOUT_MS=10000
