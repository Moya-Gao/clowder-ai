# Cat Cafe 环境变量配置
# 复制此文件为 .env 并填入你的配置

# ======================
# API Keys (必填)
# ======================

# Anthropic API Key - 布偶猫 (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key - 缅因猫 (Codex)
OPENAI_API_KEY=sk-...

# Google API Key - 暹罗猫 (Gemini)
GOOGLE_API_KEY=...

# ======================
# 服务端口
# ======================

# MCP Server 端口
MCP_SERVER_PORT=3001

# API Backend 端口
API_SERVER_PORT=3002

# API Backend 监听地址（默认仅本机访问；如需局域网访问可设为 0.0.0.0）
API_SERVER_HOST=127.0.0.1

# Frontend 端口 (MCP Server 不再占 3001，前端直接用)
FRONTEND_PORT=3001

# ======================
# Hindsight（本仓库独立实例）
# ======================

# 本仓库默认使用 18888/19999，避免与其他项目冲突
HINDSIGHT_URL=http://localhost:18888
HINDSIGHT_SHARED_BANK=cat-cafe-shared
HINDSIGHT_HEALTH_TIMEOUT_SECONDS=5
HINDSIGHT_STARTUP_TIMEOUT_SECONDS=300
HINDSIGHT_COMPOSE_PROJECT=cat-cafe-hindsight-local-instance

# ======================
# Redis 配置
# ======================

# Redis 连接 URL
REDIS_URL=redis://localhost:6379

# ======================
# 数据存储
# ======================

# Cat Cafe 数据目录
CAT_CAFE_DATA_DIR=~/.cat-cafe

# 允许访问的工作目录 (逗号分隔)
ALLOWED_WORKSPACE_DIRS=/Users/lysander/projects

# ======================
# 模型配置 (可选覆盖)
# ======================

# 布偶猫模型 (默认: claude-sonnet-4-5-20250929)
# CAT_OPUS_MODEL=claude-opus-4-6

# 缅因猫模型 (默认: codex)
# CAT_CODEX_MODEL=gpt-5.3-codex

# 缅因猫 CLI 沙箱模式 (默认: danger-full-access，确保 callback 模式可写 .git 完成提交)
# 可选: read-only | workspace-write | danger-full-access
# CAT_CODEX_SANDBOX_MODE=danger-full-access

# 缅因猫 CLI 授权策略 (默认: on-request，支持动态授权交互)
# 可选: untrusted | on-failure | on-request | never
# CAT_CODEX_APPROVAL_POLICY=on-request

# 暹罗猫模型 (默认: gemini-2.5-pro)
# CAT_GEMINI_MODEL=gemini-3-pro

# A2A 猫猫互调最大深度 (默认: 2)
# MAX_A2A_DEPTH=2

# ======================
# 开发选项
# ======================

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 是否启用详细日志
DEBUG=false
