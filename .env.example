# Cat Cafe 环境变量配置
# 复制此文件为 .env 并填入你的配置

# ======================
# API Keys (必填)
# ======================

# Anthropic API Key - 布偶猫 (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key - 缅因猫 (Codex)
OPENAI_API_KEY=sk-...

# Google API Key - 暹罗猫 (Gemini)
GOOGLE_API_KEY=...

# ======================
# Owner Identity
# ======================

# Owner identity for privileged operations.
# - Default cat selection: works without this (falls back to 'default-user')
# - Sensitive env writes: REQUIRES this to be explicitly set (403 otherwise)
# For multi-user deployments, set this to your actual user ID.
# DEFAULT_OWNER_USER_ID=default-user

# ======================
# 服务端口
# ======================

# MCP Server 端口
MCP_SERVER_PORT=3011

# API Backend 端口
API_SERVER_PORT=3012

# API Backend 监听地址（默认仅本机访问；如需局域网访问可设为 0.0.0.0）
API_SERVER_HOST=127.0.0.1

# 允许局域网/Tailscale 设备访问（手机、平板等）
# 开启后 192.168.x.x / 10.x.x.x / Tailscale 100.x.x.x 的浏览器可正常连接
# 需要同时设置 API_SERVER_HOST=0.0.0.0
# CORS_ALLOW_PRIVATE_NETWORK=true

# Frontend 端口 (dev 默认 3011，避免和 runtime 的 3001 冲突)
FRONTEND_PORT=3011

# Preview Gateway 端口 (F120 独立 origin 反向代理，多 runtime 并行时需各自不同)
PREVIEW_GATEWAY_PORT=4100

# CLI 静默超时（毫秒）
# 默认 1800000 = 30 分钟；设为 0 可禁用 CLI 层超时
# CLI_TIMEOUT_MS=1800000

# ======================
# Redis 配置
# ======================

# Redis 端口（governance pack 用于生成外部项目规则，clowder-ai#805）
REDIS_PORT=6399

# Redis 连接 URL
# 内部约定：runtime=6399, worktree/dev=6398
# start-dev.sh 会根据启动模式自动设置，一般不需手动改
REDIS_URL=redis://localhost:6399

# Redis key 命名空间前缀
# 多实例共享同一 Redis 时，用不同前缀隔离数据（默认 cat-cafe:）
# REDIS_KEY_PREFIX=cat-cafe:

# Redis 数据 TTL（秒）
# ⚠️ 默认 0 = 永久保存（推荐）。设为 >0 会在到期后自动删除数据！
# 除非你明确需要自动清理旧数据，否则不要修改。
MESSAGE_TTL_SECONDS=0
THREAD_TTL_SECONDS=0
TASK_TTL_SECONDS=0
SUMMARY_TTL_SECONDS=0
BACKLOG_TTL_SECONDS=0

# ======================
# 数据存储
# ======================

# Cat Cafe 数据目录
CAT_CAFE_DATA_DIR=~/.cat-cafe

# 允许访问的工作目录 (逗号分隔)
ALLOWED_WORKSPACE_DIRS=/Users/lysander/projects

# ======================
# 模型配置 (可选覆盖)
# ======================

# 布偶猫模型 (默认: claude-sonnet-4-5-20250929)
# CAT_OPUS_MODEL=claude-opus-4-6

# 缅因猫模型 (默认: codex)
# CAT_CODEX_MODEL=gpt-5.3-codex

# 缅因猫 CLI 沙箱模式 (默认: danger-full-access，确保 callback 模式可写 .git 完成提交)
# 可选: read-only | workspace-write | danger-full-access
# CAT_CODEX_SANDBOX_MODE=danger-full-access

# 缅因猫 CLI 授权策略 (默认: on-request，支持动态授权交互)
# 可选: untrusted | on-failure | on-request | never
# CAT_CODEX_APPROVAL_POLICY=on-request

# 暹罗猫模型 (默认: gemini-2.5-pro)
# CAT_GEMINI_MODEL=gemini-3-pro

# A2A 猫猫互调最大深度 (默认: 2)
# MAX_A2A_DEPTH=2

# ======================
# 开发选项
# ======================

# 官方额度抓取浏览器（默认隔离，不会关闭当前 Chrome）
# 官方额度抓取总开关（默认 0，临时禁用；设为 1 才允许抓取）
# QUOTA_OFFICIAL_REFRESH_ENABLED=0
#
# 可选: isolated | existing
# isolated: 启动独立 profile 的 Chrome（推荐）
# existing: 复用现有本机 CDP（高级场景）
# QUOTA_BROWSER_MODE=isolated

# 隔离浏览器 CDP 端口（默认 9224）
# QUOTA_BROWSER_CDP_PORT=9224

# 隔离浏览器 profile 目录（默认 ~/.cat-cafe/quota-browser-profile）
# QUOTA_BROWSER_PROFILE_DIR=/Users/you/.cat-cafe/quota-browser-profile

# 是否启用无头模式（1=启用，0=关闭；默认 0）
# 首次使用建议保持 0，先完成网页登录。
# QUOTA_BROWSER_HEADLESS=0

# 是否允许自动启动隔离浏览器（仅 interactive=true 请求生效；默认 1）
# QUOTA_BROWSER_AUTO_START=1

# 是否允许自动重启浏览器（默认 0，危险操作）
# QUOTA_BROWSER_AUTO_RESTART=0

# 遥测 HMAC 盐（用于 ID 伪名化，发往 Sentry 等外部遥测）
# 安装脚本会自动生成；非开发环境必须配置。
# TELEMETRY_HMAC_SALT=

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# API 滚动日志目录
LOG_DIR=./data/logs/api

# 是否启用详细日志
DEBUG=false

# 本地语义检索（F102 记忆系统）
# 本地 embedding sidecar 会在 EMBED_MODE=shadow|on 时自动拉起
# Unix: scripts/embed-server.sh / Windows: scripts/embed-server.ps1
# Apple Silicon 优先 MLX，其它平台回落到 sentence-transformers
EMBED_MODE=off
# EMBED_PORT=9880
# EMBED_URL=http://127.0.0.1:9880

# ======================
# Push 调试（可选）
# ======================

# 若 API 所在环境需要代理访问 FCM/Web Push，可配置 HTTP(S) 代理
# HTTPS_PROXY=http://127.0.0.1:7897

# Web Push 请求超时（毫秒，默认 10000）
# WEB_PUSH_TIMEOUT_MS=10000

# ======================
# 聊天平台 Gateway (F088)
# ======================

# Telegram Bot Token (from @BotFather)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# 飞书/Lark App (from 飞书开放平台)
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_VERIFICATION_TOKEN=xxx  # From 飞书 Event Subscription config

# 钉钉企业内部应用 (Stream SDK 长连接模式, F132 Phase A)
# DINGTALK_APP_KEY=xxx     # 钉钉开放平台 → 应用开发 → 企业内部应用 → 凭证与基础信息
# DINGTALK_APP_SECRET=xxx  # 同上

# 企业微信智能机器人 (WebSocket 长连接模式)
# WECOM_BOT_ID=xxx      # 企业微信管理后台 → 智能机器人 → Bot ID
# WECOM_BOT_SECRET=xxx   # 企业微信管理后台 → 智能机器人 → Bot Secret

# 企业微信自建应用 (HTTP 回调模式, F132 Phase C)
# WECOM_CORP_ID=xxx              # 企业 ID (我的企业 → 企业信息)
# WECOM_AGENT_ID=xxx             # 应用 AgentId (应用管理 → 自建应用)
# WECOM_AGENT_SECRET=xxx         # 应用 Secret
# WECOM_TOKEN=xxx                # 回调 Token (API 接收消息 → Token)
# WECOM_ENCODING_AES_KEY=xxx     # 回调 EncodingAESKey (43 字符)
