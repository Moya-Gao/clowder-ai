# Worktree 开发环境配置示例
# 复制为 .env.local 并根据需要调整

# ⚠️ CRITICAL: Worktree 必须使用开发 Redis 6398，绝对不要用 6399！
REDIS_URL=redis://localhost:6398

# API 服务端口（避免与主环境 3002 冲突）
API_SERVER_PORT=3102

# 前端 API 地址
NEXT_PUBLIC_API_URL=http://localhost:3102

# Worktree 仍使用本仓库独立 Hindsight 实例
HINDSIGHT_URL=http://localhost:18888
HINDSIGHT_STARTUP_TIMEOUT_SECONDS=300
HINDSIGHT_COMPOSE_PROJECT=cat-cafe-hindsight-local-instance

# 可选：强制使用内存存储（最安全，但无法测试 Redis 功能）
# MEMORY_STORE=1
