#!/bin/bash
# .githooks/pre-push — Direct Push to Main 阻断
#
# 只做一件事：阻止直接 push 到 main/master。
# 所有 main 上的改动应通过 PR squash merge（merge-gate 流程）。
#
# 不承担全量测试职责——那是 pre-merge-check.sh（pnpm gate）的活。
# 原因：pre-push 时的 "全绿" 不代表 merge 到 main 后还绿。
#
# 注意：不区分主仓库/次级 worktree——任何 worktree 都不能直接 push
# 代码到 main。gh pr merge --squash 是 GitHub 服务端操作，不经过
# 本地 pre-push hook，所以不会被误拦。
#
# 安全原则：fail closed。无法判断时一律 block。

# 读 push 目标分支（stdin 格式：local_ref local_sha remote_ref remote_sha）
while read local_ref local_sha remote_ref remote_sha; do
  REMOTE_BRANCH="$(echo "$remote_ref" | sed 's|refs/heads/||')"

  if [ "$REMOTE_BRANCH" = "main" ] || [ "$REMOTE_BRANCH" = "master" ]; then

    # ── 确定 diff 基准 ──
    # remote_sha 全零 = 远端没有这个 ref（bootstrap / mirror）。
    # 此时无法 diff against remote，改为 diff against empty tree，
    # 让白名单逻辑正常运行（bootstrap 只含 docs → 放行）。
    DIFF_BASE="$remote_sha"
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      DIFF_BASE="$(git hash-object -t tree /dev/null)"
    elif ! git cat-file -e "$remote_sha" 2>/dev/null; then
      # remote_sha 不在本地对象库（stale clone / 未 fetch）。
      # 无法确认改动内容，fail closed。
      echo "" >&2
      echo "🚫 BLOCKED: remote SHA $remote_sha 不在本地对象库。" >&2
      echo "   请先 git fetch origin 同步后重试。" >&2
      echo "   （安全原则：无法确认改动内容时一律 block）" >&2
      exit 1
    fi

    # 允许的例外：纯文档/共享状态/技能文档/Agent配置同步（shared-rules §14）
    # 严格白名单：docs/ + cat-config.json + cat-cafe-skills/ + .claude/skills/（symlink）
    #   + Agent 配置文件（AGENTS.md / CLAUDE.md / GEMINI.md / .githooks/）
    # 应用代码一律走 PR
    CHANGED_FILES="$(git diff --name-only "$DIFF_BASE".."$local_sha" 2>/dev/null)"
    if [ -z "$CHANGED_FILES" ]; then
      # diff 成功但无改动（remote_sha 已验证存在），真的无改动，放行
      continue
    fi
    NON_DOC_FILES="$(echo "$CHANGED_FILES" | grep -v -E '^(docs/|cat-config\.json$|cat-cafe-skills/|\.claude/skills/|\.githooks/|AGENTS\.md$|CLAUDE\.md$|GEMINI\.md$)' || true)"

    if [ -z "$NON_DOC_FILES" ]; then
      # 只有文档/共享状态/技能文档变更，允许直接 push
      continue
    fi

    echo "" >&2
    echo "╔══════════════════════════════════════════════════════════════╗" >&2
    echo "║  🚫 BLOCKED: 禁止直接 push 代码到 $REMOTE_BRANCH！" >&2
    echo "║                                                            ║" >&2
    echo "║  正确做法：                                                ║" >&2
    echo "║    1. 在 feature worktree 开发                             ║" >&2
    echo "║    2. pnpm gate（全量门禁检查）                            ║" >&2
    echo "║    3. 走 merge-gate：PR → review → squash merge            ║" >&2
    echo "║                                                            ║" >&2
    echo "║  例外：docs/ + cat-config.json + cat-cafe-skills/ + .claude/skills/ ║" >&2
    echo "║        + AGENTS.md/CLAUDE.md/GEMINI.md + .githooks/ 可直接 push    ║" >&2
    echo "╚══════════════════════════════════════════════════════════════╝" >&2
    echo "" >&2
    exit 1
  fi
done

exit 0
