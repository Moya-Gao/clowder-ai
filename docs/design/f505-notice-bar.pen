{
  "version": "2.10",
  "children": [
    {
      "type": "frame",
      "id": "5lr78",
      "name": "SystemNoticeBar Showcase",
      "width": 800,
      "layout": "vertical",
      "gap": 28,
      "padding": [
        60,
        60,
        60,
        60
      ],
      "fill": "#FFF8F1",
      "alignItems": "center",
      "children": [
        {
          "type": "frame",
          "id": "vZwnl",
          "name": "Tone/Info",
          "width": 640,
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "frame",
              "id": "vZwnl-meta",
              "name": "meta",
              "width": 640,
              "gap": 8,
              "padding": [
                0,
                4
              ],
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "vZwnl-label",
                  "name": "label",
                  "fill": "#5F7D9A",
                  "content": "Routing hint",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "medium"
                },
                {
                  "type": "text",
                  "id": "vZwnl-time",
                  "name": "time",
                  "fill": "#8A776B",
                  "content": "12:34",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "vZwnl-box",
              "name": "noticeBox",
              "width": 640,
              "fill": "#FFFDF8",
              "cornerRadius": 16,
              "stroke": {
                "thickness": 1,
                "fill": "#D9E5F1"
              },
              "gap": 12,
              "padding": [
                14,
                18
              ],
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "vZwnl-icon",
                  "name": "icon",
                  "fill": "#6488B0",
                  "content": "💡",
                  "fontFamily": "Inter",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "vZwnl-body",
                  "name": "body",
                  "fill": "#6A5A50",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "想交接给 @codex？把它单独放到新起一行开头，才能触发交接。",
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "TDdKe",
          "name": "Tone/Warning",
          "width": 640,
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "frame",
              "id": "TDdKe-meta",
              "name": "meta",
              "width": 640,
              "gap": 8,
              "padding": [
                0,
                4
              ],
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "TDdKe-label",
                  "name": "label",
                  "fill": "#9A6A32",
                  "content": "重启通知",
                  "fontFamily": "Inter",
