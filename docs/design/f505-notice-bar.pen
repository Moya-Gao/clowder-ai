                  "fontWeight": "medium"
                },
                {
                  "type": "text",
                  "id": "TDdKe-time",
                  "name": "time",
                  "fill": "#8A776B",
                  "content": "12:34",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "TDdKe-box",
