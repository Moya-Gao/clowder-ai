{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-spec.v1",
  "title": "Video Spec v1 — F138 Segment Contract",
  "description": "Schema-driven video production contract. Global audio + 4-layer segments. Supports editorial (draft) and render-ready (strict) modes.",
  "type": "object",
  "required": ["id", "version", "status", "meta", "global_audio", "segments"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": ["editorial", "render-ready"],
      "description": "editorial = draft, fields may be incomplete; render-ready = all rendering fields required"
    },
    "meta": {
      "type": "object",
      "required": ["title", "target_duration_ms", "fps", "resolution"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "target_duration_ms": { "type": "integer" },
        "fps": { "type": "integer", "default": 30 },
        "resolution": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "default": 1920 },
            "height": { "type": "integer", "default": 1080 }
          }
        },
        "vibe_arc": {
          "type": "array",
          "description": "Overall emotional arc of the video, ordered by time",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from_pct": { "type": "number", "minimum": 0, "maximum": 1 },
              "to_pct": { "type": "number", "minimum": 0, "maximum": 1 },
              "vibe": { "enum": ["hype", "chill", "suspense", "warm"] }
            }
          }
        },
        "bgm_ref": { "type": "string" },
        "type": {
          "type": "string",
          "description": "Video type: general, knowledge-explainer, showcase, tutorial, intro (KD-15)"
        },
        "style": {
          "type": "string",
          "description": "Named visual style from style-recipes (AC-1i, KD-15)"
        }
      }
    },
    "global_audio": {
      "type": "object",
      "description": "Single continuous TTS output — never segment-level!",
      "required": ["script_text", "speaker_id"],
      "additionalProperties": false,
      "properties": {
        "script_text": { "type": "string", "description": "Full narration script, read in one pass" },
        "audio_uri": { "type": "string", "description": "Path to global TTS wav/mp3" },
        "speaker_id": { "type": "string" },
        "voice_profile_id": { "type": "string" },
        "word_timestamps": {
          "type": "array",
          "description": "From forced alignment (Qwen3-FA / WhisperX), NOT TTS native",
          "items": {
            "type": "object",
            "required": ["index", "word", "start_ms", "end_ms"],
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "description": "Stable positional index for highlighting, diff, and patch"
              },
              "word": { "type": "string" },
              "start_ms": { "type": "integer" },
              "end_ms": { "type": "integer" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "alignment_source": {
          "enum": ["qwen3-fa", "whisperx", "mfa", "manual"],
          "description": "Which aligner produced word_timestamps"
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "narration", "render", "control"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },

          "source": {
            "type": "object",
            "required": ["type", "timeline_range"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": ["clip", "screen_recording", "image", "b_roll", "freeze", "generated"],
                "description": "What this segment IS (asset type). Distinct from retiming_strategy (what to do when duration mismatches)."
              },
              "source_range": {
                "type": "object",
                "description": "Which part of the original asset to use",
                "additionalProperties": false,
                "required": ["start_ms", "end_ms"],
                "properties": {
                  "start_ms": { "type": "integer" },
                  "end_ms": { "type": "integer" }
                }
              },
              "timeline_range": {
                "type": "object",
                "description": "Where this segment sits on the final video timeline",
                "additionalProperties": false,
                "required": ["start_ms", "end_ms"],
                "properties": {
                  "start_ms": { "type": "integer" },
                  "end_ms": { "type": "integer" }
                }
              },
              "asset_refs": {
                "type": "array",
                "items": { "type": "string" }
              },
              "visual_summary": { "type": "string" },
              "visual_anchor_ms": {
                "type": "integer",
                "description": "Key visual action moment within source_range (Path A semantic alignment)"
              }
            }
          },

          "narration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "global_audio_range": {
                "type": "object",
                "description": "Which slice of global_audio covers this segment",
                "additionalProperties": false,
                "required": ["start_ms", "end_ms"],
                "properties": {
                  "start_ms": { "type": "integer" },
                  "end_ms": { "type": "integer" }
                }
              },
              "audio_anchor_ms": {
                "type": "integer",
                "description": "Key narration word timestamp for semantic alignment with visual_anchor_ms"
              },
              "target_duration_ms": { "type": "integer" },
              "semantic_alignment_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "How well narration matches visual content (Path A QA)"
              }
            }
          },

          "render": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "template_id": { "type": "string" },
              "retiming_strategy": {
                "enum": ["TRIM", "FREEZE_STYLIZED", "B_ROLL", "SLOW_MO", "LOOP"],
                "description": "What to do when asset duration != narration duration. Priority: TRIM > FREEZE_STYLIZED > B_ROLL > SLOW_MO > LOOP"
              },
              "freeze_at_ms": {
                "type": "integer",
                "description": "For FREEZE_STYLIZED: which source_range ms to freeze on"
              },
              "fallback_asset_refs": {
                "type": "array",
                "items": { "type": "string" },
                "description": "For B_ROLL: supplementary assets to fill duration gap"
              },
              "vibe": { "enum": ["hype", "chill", "suspense", "warm"] },
              "captions_style": { "enum": ["narration", "keyLine", "minimal", "none"] },
              "playback_rate": {
                "type": "number",
                "minimum": 0.7,
                "description": "Only for SLOW_MO, minimum 0.7x"
              },
              "music_ref": { "type": "string" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "retiming_strategy": { "const": "FREEZE_STYLIZED" } },
                  "required": ["retiming_strategy"]
                },
                "then": { "required": ["freeze_at_ms"] }
              },
              {
                "if": {
                  "properties": { "retiming_strategy": { "const": "B_ROLL" } },
                  "required": ["retiming_strategy"]
                },
                "then": { "required": ["fallback_asset_refs"] }
              },
              {
                "if": {
                  "properties": { "retiming_strategy": { "const": "SLOW_MO" } },
                  "required": ["retiming_strategy"]
                },
                "then": { "required": ["playback_rate"] }
              }
            ]
          },

          "control": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "locks": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Field paths that are confirmed and should not change"
              },
              "review_state": { "enum": ["pending", "approved", "rejected"] },
              "version": { "type": "integer" },
              "last_patch_reason": { "type": "string" }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "description": "Transitions between segments. Phase 1: cut/fade only.",
      "items": {
        "type": "object",
        "required": ["from_segment_id", "to_segment_id", "transition_type"],
        "additionalProperties": false,
        "properties": {
          "from_segment_id": { "type": "string" },
          "to_segment_id": { "type": "string" },
          "transition_type": {
            "enum": ["cut", "fade"],
            "description": "Phase 1 supports cut and fade only. slide/wipe deferred to Phase 2."
          },
          "duration_ms": { "type": "integer", "default": 500, "description": "Ignored for cut" }
        }
      }
    }
  },

  "if": { "properties": { "status": { "const": "render-ready" } } },
  "then": {
    "properties": {
      "global_audio": {
        "required": ["script_text", "speaker_id", "audio_uri", "word_timestamps", "alignment_source"]
      },
      "segments": {
        "items": {
          "properties": {
            "source": {
              "required": ["type", "timeline_range", "asset_refs"]
            },
            "narration": {
              "required": ["global_audio_range", "target_duration_ms"]
            },
            "render": {
              "required": ["template_id", "retiming_strategy", "vibe", "captions_style"]
            }
          }
        }
      }
    }
  }
}
