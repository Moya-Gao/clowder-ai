{
  "name": "@cat-cafe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --dir ../shared build && tsc",
    "start": "node dist/index.js",
    "test": "pnpm run build && node --test test/*.test.js",
    "fetch-signals": "node dist/scripts/fetch-signals.js",
    "migrate-signals": "node dist/scripts/migrate-signals.js",
    "hindsight:import:p0": "node dist/scripts/hindsight-import-p0.js",
    "test:redis": "bash ./scripts/run-isolated-redis-tests.sh",
    "test:redis:repeat": "bash ./scripts/run-isolated-redis-tests.sh --repeat 2",
    "test:integration": "node --test test/integration/*.test.js",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cat-cafe/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/multipart": "8",
    "@fastify/static": "7",
    "@fastify/websocket": "^10.0.0",
    "cheerio": "^1.1.2",
    "fastify": "^4.25.0",
    "imapflow": "^1.2.10",
    "ioredis": "^5.3.0",
    "js-tiktoken": "^1.0.21",
    "nodemailer": "^6.9.16",
    "puppeteer": "^24.37.2",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "smol-toml": "^1.6.0",
    "socket.io": "^4.7.0",
    "web-push": "^3.6.7",
    "yaml": "^2.8.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.17",
    "@types/puppeteer": "^7.0.4",
    "@types/sharp": "^0.32.0",
    "@types/web-push": "^3.6.4",
    "fast-check": "^4.5.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
