{
  "name": "@cat-cafe/convention-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "cat-cafe-convention-graph": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "convention-graph": "node src/cli.ts",
    "graph:index": "node src/cli.ts index",
    "graph:code-consumers": "node src/cli.ts code-consumers",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "typescript": "^5.3.3"
  }
}
